# Telegram API Credentials (required unless loaded from macOS Keychain)
# Get these from https://my.telegram.org/apps.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- Incoming event feed (optional, Claude Code callback mode; see README) ---
# TELEGRAM_EVENT_FEED=1
# TELEGRAM_EVENT_FEED_FILE=/path/to/incoming_feed.jsonl

# --- Single account (backward-compatible) ---
# Option 1: File-based session (a .session file will be created on disk)
# TELEGRAM_SESSION_NAME=telegram_session
# Option 2: String-based session (no file on disk; recommended)
# TELEGRAM_SESSION_STRING=1231231232erfdfdffd

# --- macOS Keychain (recommended; more secure alternative to storing values above) ---
# Store credentials in the system keychain so they never appear in plaintext files.
# Run once to store each value:
#   security add-generic-password -a "$USER" -s telegram-api-id      -w "YOUR_API_ID"
#   security add-generic-password -a "$USER" -s telegram-api-hash     -w "YOUR_API_HASH"
#   security add-generic-password -a "$USER" -s telegram-session-string -w "YOUR_SESSION_STRING"
#
# Makefile start targets use scripts/start.sh, which reads these Keychain
# items automatically. When using Keychain, leave the plaintext fields above
# commented out or ignored.

# --- Multiple accounts ---
# Add _<LABEL> suffix to session variables. Labels become account identifiers.
# Shared API_ID and API_HASH are used for all accounts.
# TELEGRAM_SESSION_STRING_WORK=<session string for work account>
# TELEGRAM_SESSION_STRING_PERSONAL=<session string for personal account>

# --- Session pool (same account, concurrent clients) ---
# Run several MCP clients (e.g. the desktop app AND a terminal CLI) against ONE
# Telegram account without hitting AuthKeyDuplicatedError. Telegram forbids a
# single session (auth key) being used from two IPs at once; on a VPN/dual-stack
# host two local clients can collide. List several interchangeable session
# strings (whitespace, comma or semicolon separated) and each process claims a
# free one via an advisory file lock. Generate extra sessions with
# `uv run session_string_generator.py`. Takes precedence over
# TELEGRAM_SESSION_STRING for the default account.
# TELEGRAM_SESSION_STRINGS=<session A> <session B> <session C>

# --- Device identity (optional) ---
# Controls how this client appears in Telegram > Settings > Devices. If unset,
# Telethon falls back to the host platform (e.g. "arm64"). Set these so the
# session keeps a stable, recognisable name across reconnects. Applied both
# when generating a session string and when the server connects.
# TELEGRAM_DEVICE_MODEL=Telegram MCP
# TELEGRAM_SYSTEM_VERSION=1.0
# TELEGRAM_APP_VERSION=1.0

# --- Streamable HTTP / SSE transport (optional) ---
# `make start` starts Streamable HTTP through scripts/start.sh, which loads
# Telegram credentials from Keychain before starting the server:
#   MCP_HOST=127.0.0.1 ./scripts/start.sh --transport http --port 8765
#
# You normally do not need to set these in .env when using Makefile targets.
# Uncomment them only if you start `uv run main.py` directly or want different
# defaults. Streamable HTTP uses /mcp; legacy SSE uses /sse.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
#
# HTTP/SSE auth is optional for local-only use. If TELEGRAM_MCP_TOKEN is set,
# clients must send `Authorization: Bearer <token>`. Leave it commented out
# when using unauthenticated localhost development.
# TELEGRAM_MCP_TOKEN=<random shared secret>

# --- Tool access control (optional) ---
# The following high-risk tools are DISABLED by default (not visible to the MCP
# client). They cover irreversible deletes, privilege escalation, bulk
# personal-data writes, and account-wide config changes:
#   delete_message, delete_chat_history, delete_messages_bulk,
#   delete_scheduled_message, delete_folder, delete_contact,
#   delete_profile_photo, delete_chat_photo, ban_user,
#   promote_admin, demote_admin, edit_admin_rights,
#   create_group, create_channel,
#   export_contacts, export_chat_invite, import_contacts,
#   set_privacy_settings, leave_chat
#
# Two comma-separated env vars adjust the effective blocklist:
#   TELEGRAM_EXTRA_UNBLOCKED_TOOLS  — re-enable specific tools from the default list
#   TELEGRAM_EXTRA_BLOCKED_TOOLS — additionally disable normally-enabled tools
# Conflict rule: a tool listed in both vars stays DISABLED.
#
# Example — re-enable only delete_message (rest of the default list stays off):
# TELEGRAM_EXTRA_UNBLOCKED_TOOLS=delete_message
#
# Example — near read-only posture (also disable routine writes):
# TELEGRAM_EXTRA_BLOCKED_TOOLS=send_message,forward_message,edit_message,block_user

# --- MCP tool exposure (optional) ---
# Default is all. Set to read-only to expose only tools annotated with
# readOnlyHint=True through MCP. This does not reduce Telegram session authority
# inside the server process.
# TELEGRAM_EXPOSED_TOOLS=read-only
#
# Append '+name,name' to read-only to also expose specific write tools. Every
# other write tool stays unregistered. Unknown names abort startup.
# TELEGRAM_EXPOSED_TOOLS=read-only+send_message,reply_to_message

# --- Display timezone (optional) ---
# All timestamps in tool output are shown in this UTC offset (integer hours).
# Default: 8 (UTC+8). Set to 0 for UTC, -5 for EST, etc.
# TELEGRAM_DISPLAY_UTC_OFFSET=8

# --- download_media extension safety filter (optional) ---
# Telegram attachments are untrusted input. download_media rejects files
# whose content-detected extension is on the blocklist, not on the allowlist,
# missing, or appears as a suspicious double-extension (e.g. report.pdf.exe).
# Telethon writes the file based on actual content (not caller-supplied
# filename), so this filter is content-based and resistant to spoofing.
#
# If unset, sensible defaults are used (see telegram_mcp/tools/media.py).
# Set either var to FULLY REPLACE the corresponding default list.
# Format: comma-separated, case-insensitive, leading dot optional.
#
# Default allowlist (uncomment and edit to override):
# TELEGRAM_DOWNLOAD_ALLOWED_EXT=jpg,jpeg,png,webp,heic,heif,gif,mp4,mov,webm,mp3,m4a,ogg,pdf,txt,md,csv,doc,docx,xls,xlsx,ppt,pptx
#
# Default blocklist (uncomment and edit to override):
# TELEGRAM_DOWNLOAD_BLOCKED_EXT=exe,msi,bat,cmd,sh,bash,zsh,ps1,vbs,vbe,js,jse,wsf,wsh,scr,com,pif,cpl,reg,app,dmg,pkg,mpkg,deb,rpm,apk,ipa,appimage,run,bin,mjs,cjs,py,pyc,pyo,rb,pl,php,phtml,jar,war,ear,class,lua,tcl,docm,xlsm,pptm,dotm,xltm,potm,svg,html,htm,xhtml,xsl,xslt,mht,mhtml,lnk,url,desktop,webloc,inf,iso,vhd,vhdx,zip,rar,7z,tar,gz,tgz,bz2,xz,cab,ace,arj,lzh
#
# Note: blocklist takes priority over allowlist. To allow archives like .zip,
# you must REMOVE them from TELEGRAM_DOWNLOAD_BLOCKED_EXT *and* ADD them to
# TELEGRAM_DOWNLOAD_ALLOWED_EXT.

# --- File-path tools / allowed roots (optional) ---
# Explicit server-side allowlist for local file reads/writes. Loaded from .env
# and merged with CLI roots. Separate multiple roots with commas.
# Keep the scope narrow; do not grant your whole home or workspace.
TELEGRAM_MCP_ALLOWED_ROOTS="~/Downloads/telegram_mcp_files"
# Add the summary project's docs/chat root with commas. Replace <project_root>
# with the actual absolute path on your machine, for example:
# TELEGRAM_MCP_ALLOWED_ROOTS="~/Downloads/telegram_mcp_files,<project_root>/docs/chat"
#
# When the MCP client implements Roots but advertises an empty list — or when
# list_roots fails unexpectedly and no client paths can be recovered —
# file-path tools (download_media, send_file, ...) are disabled (deny-all) even
# if server CLI roots are configured. Set this to 1/true to fall back to the
# server CLI roots in those cases. Default is deny-all.
# TELEGRAM_ALLOW_SERVER_ROOTS_FALLBACK=1
#
# NOT read from this file. scripts/setup.sh does not load .env, so
# TELEGRAM_MCP_SUMMARY_PROJECT only has an effect when passed on the command
# line. When set, setup.sh grants that project's docs/chat/ if it contains
# .claude/commands/telegram-summary.md. Use an absolute path or $HOME — a
# literal ~ is not expanded by the shell inside a variable:
#   TELEGRAM_MCP_SUMMARY_PROJECT="$HOME/path/to/project" bash scripts/setup.sh

# --- HTTP/SSE transport security (optional) ---
# Only relevant when MCP_TRANSPORT=http or sse. If the server is reachable via
# a domain (e.g. behind a reverse proxy) rather than only 127.0.0.1/localhost,
# set MCP_ALLOWED_HOSTS to enable DNS-rebinding protection and allow that Host
# header. Comma-separated; supports a ":*" suffix to allow any port.
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://mcp.example.com

# --- Proxy (optional) ---
# Route Telegram traffic through a proxy. Set TELEGRAM_PROXY_TYPE to enable.
# Supported types: socks5, socks4, http, mtproxy.
# SOCKS/HTTP proxies require the 'python-socks' package (install via
# `uv sync --extra proxy` or `pip install python-socks`).
# Per-account overrides use the same _<LABEL> suffix as session variables.
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_USERNAME=<optional>
# TELEGRAM_PROXY_PASSWORD=<optional>
# TELEGRAM_PROXY_RDNS=true
# For MTProxy, set TELEGRAM_PROXY_TYPE=mtproxy and provide the secret:
# TELEGRAM_PROXY_SECRET=<hex secret>
# Per-account override example:
# TELEGRAM_PROXY_TYPE_WORK=http
# TELEGRAM_PROXY_HOST_WORK=proxy.work.example
# TELEGRAM_PROXY_PORT_WORK=3128

# --- Remembered contacts (optional) ---
# TELEGRAM_ALIASES_FILE=/path/to/aliases.json
# TELEGRAM_CONTACT_FUZZY=0   # exact-match aliases only

# --- Sent message ID reporting (optional) ---
# send_message, reply_to_message, send_file, forward_message, etc. append the
# id(s) of what they sent so the caller can immediately reference the new
# message (reply_to / edit / pin / link) without re-fetching history.
# Set to 0 to suppress the suffix if the extra text is unwanted.
# TELEGRAM_SHOW_SENT_ID=1
